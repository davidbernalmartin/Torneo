"""
PDF de agenda de partidos organizado por día y campo de fútbol.
Reutiliza la paleta y primitivas de pdf_partidos.py.
"""
import io
import urllib.request
from datetime import datetime
from collections import defaultdict

from reportlab.lib.pagesizes import A4
from reportlab.lib.colors import HexColor, white
from reportlab.pdfgen import canvas as pdf_canvas
from reportlab.lib.utils import ImageReader

# ── Paleta ────────────────────────────────────────────────────────────────────
RED      = HexColor("#CC0000")
DARK     = HexColor("#1A1A1A")
MUTED    = HexColor("#888888")
LIGHT_BG = HexColor("#F7F7F7")
BORDER   = HexColor("#E0E0E0")
WHITE    = white

FIELD_BG     = HexColor("#1A3A5F")   # azul oscuro para cabecera de campo
FIELD_ACCENT = HexColor("#005BAB")

DAY_BG       = HexColor("#CC0000")   # rojo para cabecera de día

# ── Dimensiones ───────────────────────────────────────────────────────────────
PAGE_W, PAGE_H = A4
MARGIN   = 30
CARD_W   = PAGE_W - 2 * MARGIN
HDR_H    = 38
CARD_H   = 68
SHIELD_S = 38
PAD_X    = 14
VS_W     = 52
INFO_H   = 16
CORNER   = 8
STRIP_W  = 5
CARD_GAP = 6
DAY_H    = 30
FIELD_H  = 22
GRP_GAP  = 10


# ── Utilidades ────────────────────────────────────────────────────────────────

def _fetch_img(url, cache):
    if not url:
        return None
    if url in cache:
        return cache[url]
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=6) as r:
            data = r.read()
        img = ImageReader(io.BytesIO(data))
        cache[url] = img
        return img
    except Exception:
        cache[url] = None
        return None


def _draw_shield(c, img, cx, cy, size):
    x, y = cx - size / 2, cy - size / 2
    if img:
        try:
            c.drawImage(img, x, y, size, size, preserveAspectRatio=True, mask="auto")
            return
        except Exception:
            pass
    c.setFillColor(LIGHT_BG)
    c.setStrokeColor(BORDER)
    c.setLineWidth(0.5)
    c.roundRect(x, y, size, size, 4, fill=1, stroke=1)


def _fit_name(c, text, font, max_size, max_w):
    sz = max_size
    while sz >= 6 and c.stringWidth(text, font, sz) > max_w:
        sz -= 0.5
    if c.stringWidth(text, font, sz) > max_w:
        t = text
        while t and c.stringWidth(t + "…", font, sz) > max_w:
            t = t[:-1]
        text = t + "…"
    return text, sz


# ── Tarjeta de partido ────────────────────────────────────────────────────────

def _draw_card(c, x, y, partido, cache):
    w, h = CARD_W, CARD_H

    c.setFillColor(WHITE)
    c.setStrokeColor(BORDER)
    c.setLineWidth(0.7)
    c.roundRect(x, y, w, h, CORNER, fill=1, stroke=1)

    # barra inferior: hora + torneo/grupo
    c.setFillColor(LIGHT_BG)
    c.rect(x + CORNER, y, w - 2 * CORNER, INFO_H, fill=1, stroke=0)
    c.roundRect(x, y, w, INFO_H, CORNER, fill=1, stroke=0)
    c.setStrokeColor(BORDER)
    c.setLineWidth(0.4)
    c.line(x + CORNER, y + INFO_H, x + w - CORNER, y + INFO_H)

    meta = []
    hora = partido.get("hora")
    if hora:
        meta.append(str(hora)[:5])
    torneo = partido.get("nombre_torneo", "")
    grupo  = partido.get("nombre_grupo", "")
    if torneo:
        meta.append(torneo + (f" · {grupo}" if grupo else ""))

    c.setFont("Helvetica", 6.5)
    c.setFillColor(MUTED)
    if meta:
        c.drawCentredString(x + w / 2, y + 4.5, "   ·   ".join(meta))
    else:
        c.setFont("Helvetica-Oblique", 6.5)
        c.drawCentredString(x + w / 2, y + 4.5, "Hora pendiente")

    # zona de contenido
    content_y = y + INFO_H
    content_h = h - INFO_H
    center_y  = content_y + content_h / 2
    vs_cx     = x + w / 2

    # VS
    c.setFillColor(RED)
    c.setFont("Helvetica-Bold", 13)
    c.drawCentredString(vs_cx, center_y - 5, "VS")

    left_x1  = x + PAD_X
    left_x2  = vs_cx - VS_W / 2 - 6
    right_x1 = vs_cx + VS_W / 2 + 6
    right_x2 = x + w - PAD_X

    img_l = _fetch_img(partido.get("escudo_local"), cache)
    img_v = _fetch_img(partido.get("escudo_visitante"), cache)
    local_name = partido.get("nombre_local", "—")
    visit_name = partido.get("nombre_visitante", "—")

    # LOCAL
    _draw_shield(c, img_l, left_x1 + SHIELD_S / 2, center_y, SHIELD_S)
    name_x_l  = left_x1 + SHIELD_S + 10
    name_l, sz_l = _fit_name(c, local_name, "Helvetica-Bold", 11, left_x2 - name_x_l)
    c.setFillColor(DARK)
    c.setFont("Helvetica-Bold", sz_l)
    c.drawString(name_x_l, center_y - sz_l / 2, name_l)
    c.setFont("Helvetica", 5.5)
    c.setFillColor(MUTED)
    c.drawString(name_x_l, center_y + sz_l / 2 + 2, "LOCAL")

    # VISITANTE
    _draw_shield(c, img_v, right_x2 - SHIELD_S / 2, center_y, SHIELD_S)
    name_x2_v = right_x2 - SHIELD_S - 8
    name_v, sz_v = _fit_name(c, visit_name, "Helvetica-Bold", 11, name_x2_v - right_x1)
    c.setFillColor(DARK)
    c.setFont("Helvetica-Bold", sz_v)
    c.drawRightString(name_x2_v, center_y - sz_v / 2, name_v)
    c.setFont("Helvetica", 5.5)
    c.setFillColor(MUTED)
    c.drawRightString(name_x2_v, center_y + sz_v / 2 + 2, "VISITANTE")


# ── Cabeceras ─────────────────────────────────────────────────────────────────

def _draw_day_header(c, x, y, fecha_str):
    w = CARD_W
    c.setFillColor(DAY_BG)
    c.roundRect(x, y, w, DAY_H, 6, fill=1, stroke=0)
    c.setFillColor(WHITE)
    c.setFont("Helvetica-Bold", 12)
    c.drawString(x + 14, y + 9, fecha_str.upper())


def _draw_field_header(c, x, y, campo, n_partidos):
    w = CARD_W
    c.setFillColor(FIELD_BG)
    c.roundRect(x, y, w, FIELD_H, 4, fill=1, stroke=0)
    c.setFillColor(WHITE)
    c.setFont("Helvetica-Bold", 8.5)
    c.drawString(x + 10, y + 6.5, ("📍 " + campo).upper() if campo else "CAMPO SIN NOMBRE")
    n_str = f"{n_partidos} partido{'s' if n_partidos != 1 else ''}"
    c.setFont("Helvetica", 7.5)
    c.setFillColor(HexColor("#AACCEE"))
    c.drawRightString(x + w - 10, y + 6.5, n_str)


# ── Función principal ─────────────────────────────────────────────────────────

def generar_pdf_agenda(partidos: list, titulo: str) -> bytes:
    """
    Genera el PDF de agenda organizado por día → campo.

    partidos: lista devuelta por get_partidos_agenda (con fecha, hora, campo,
              nombre_local, nombre_visitante, escudo_local, escudo_visitante,
              nombre_torneo, nombre_grupo).
    titulo:   texto para la cabecera de página.
    """
    # ── Organizar: campo → día → [partidos] ──────────────────────────────────
    agenda: dict[str, dict[str, list]] = defaultdict(lambda: defaultdict(list))
    for p in partidos:
        fecha = str(p.get("fecha") or "")[:10]
        campo = p.get("campo") or "Sin campo asignado"
        agenda[campo][fecha].append(p)

    campos_ordenados = sorted(agenda.keys())

    buf = io.BytesIO()
    c   = pdf_canvas.Canvas(buf, pagesize=A4)
    c.setTitle(titulo)
    c.setAuthor("Gestor Torneos RFFM")

    img_cache: dict = {}

    def draw_page_header():
        hx, hy, hw = MARGIN, PAGE_H - MARGIN - HDR_H, CARD_W
        c.setFillColor(RED)
        c.roundRect(hx, hy, hw, HDR_H, 6, fill=1, stroke=0)
        c.setFillColor(WHITE)
        c.setFont("Helvetica-Bold", 13)
        t = titulo.upper()
        max_t = hw - 200
        while t and c.stringWidth(t, "Helvetica-Bold", 13) > max_t:
            t = t[:-1]
        c.drawString(hx + 14, hy + 13, t)
        c.setFont("Helvetica", 8)
        c.drawRightString(hx + hw - 14, hy + 13, "AGENDA POR CAMPO")

    def new_page():
        c.showPage()
        draw_page_header()
        return PAGE_H - MARGIN - HDR_H - 10

    draw_page_header()
    y = PAGE_H - MARGIN - HDR_H - 10

    for fecha_iso in dias_ordenados:
        campos_dia = agenda[fecha_iso]

        # formato bonito de la fecha
        try:
            dt = datetime.strptime(fecha_iso, "%Y-%m-%d")
            dia_nombres = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"]
            mes_nombres = ["enero", "febrero", "marzo", "abril", "mayo", "junio",
                           "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"]
            fecha_label = f"{dia_nombres[dt.weekday()]}, {dt.day} de {mes_nombres[dt.month-1]} de {dt.year}"
        except Exception:
            fecha_label = fecha_iso

        # espacio mínimo: cabecera día + cabecera campo + 1 tarjeta
        needed = GRP_GAP + DAY_H + CARD_GAP + FIELD_H + CARD_GAP + CARD_H
        if y - needed < MARGIN:
            y = new_page()

        y -= GRP_GAP
        _draw_day_header(c, MARGIN, y - DAY_H, fecha_label)
        y -= DAY_H + CARD_GAP

        for campo, ps in sorted(campos_dia.items()):
            # cabecera campo
            needed_field = FIELD_H + CARD_GAP + CARD_H
            if y - needed_field < MARGIN:
                y = new_page()

            _draw_field_header(c, MARGIN, y - FIELD_H, campo, len(ps))
            y -= FIELD_H + CARD_GAP

            # tarjetas de partidos del campo
            ps_sorted = sorted(ps, key=lambda p: str(p.get("hora") or ""))
            for partido in ps_sorted:
                if y - CARD_H < MARGIN:
                    y = new_page()
                _draw_card(c, MARGIN, y - CARD_H, partido, img_cache)
                y -= CARD_H + CARD_GAP

            y -= 4  # hueco extra entre campos

    c.save()
    return buf.getvalue()
